#!/bin/sh

TITLE="Terminal"
SOUND=""
MESSAGE=""

usage() {
  echo "Usage: notify [message] [options]"
  echo ""
  echo "Arguments:"
  echo "  message              The notification message (required)"
  echo ""
  echo "Options:"
  echo "  -t, --title TITLE    Custom title (default: \"Terminal\")"
  echo "  -s, --sound NAME     System sound name (e.g., Glass, Frog, Ping)"
  echo "  -h, --help           Show this help message"
  echo ""
  echo "Examples:"
  echo "  notify \"Build complete\""
  echo "  notify \"Task done\" --title \"My App\""
  echo "  notify \"Hello\" --sound \"Glass\""
  echo "  notify \"Complete\" --sound \"Frog\" --title \"Build\""
}

while [ $# -gt 0 ]; do
  case $1 in
    -h | --help)
      usage
      exit 0
      ;;
    -t | --title | -s | --sound)
      if [ $# -lt 2 ]; then
        echo >&2 "Error: Missing value for $1"
        echo >&2 "Use -h or --help for usage information."
        exit 1
      fi
      case $1 in
        -t | --title) TITLE=$2 ;;
        -s | --sound) SOUND=$2 ;;
      esac
      shift 2
      ;;
    -*)
      echo >&2 "Error: Unknown option: $1"
      echo >&2 "Use -h or --help for usage information."
      exit 1
      ;;
    *)
      if [ -z "$MESSAGE" ]; then
        MESSAGE=$1
      else
        MESSAGE="$MESSAGE $1"
      fi
      shift
      ;;
  esac
done

if [ -z "$MESSAGE" ]; then
  echo >&2 "Error: Message is required"
  echo >&2 "Usage: notify <message> [options]"
  echo >&2 "Use -h or --help for usage information."
  exit 1
fi

case "$(uname -s)" in
  Darwin)
    command -v osascript >/dev/null 2>&1 || {
      echo >&2 "Error: osascript not found"
      exit 1
    }
    if [ -n "$SOUND" ]; then
      osascript -e "display notification \"$MESSAGE\" with title \"$TITLE\" sound name \"$SOUND\""
    else
      osascript -e "display notification \"$MESSAGE\" with title \"$TITLE\""
    fi
    ;;
  Linux)
    command -v notify-send >/dev/null 2>&1 || {
      echo >&2 "Error: notify-send not found"
      exit 1
    }
    notify-send "$TITLE" "$MESSAGE"
    if [ -n "$SOUND" ] && command -v canberra-gtk-play >/dev/null 2>&1; then
      canberra-gtk-play -i "$SOUND"
    fi
    ;;
  *)
    echo >&2 "Error: Unsupported platform: $(uname -s)"
    exit 1
    ;;
esac
